rules_version = '2';

// Reglas de seguridad de Esencia Verde.
//   products       → catálogo (metadatos + miniaturas livianas)
//   productImages   → fotos en alta resolución (se cargan solo al abrir el zoom)
// Lectura pública (para que la web muestre el catálogo) y escritura solo para
// el administrador autenticado (panel admin.html con correo/contraseña).
service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /productImages/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
